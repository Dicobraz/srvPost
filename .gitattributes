# Скрипты и данные стенда исполняются на Linux-узлах как есть (shebang): только LF —
# виндовые чекауты не должны отдавать CRLF в тарболлы/копии стенда (FIX-13: сэмплер умер на python3\r).
deploy/stand/roles/*/files/* text eol=lf
deploy/stand/*.yml text eol=lf
# Диагностика Д.7 (deploy/compose/d7): скрипты монтируются в Linux-контейнеры, stand.env читается bash — только LF
deploy/compose/d7/gen/podman text eol=lf
deploy/compose/d7/stand.env text eol=lf
deploy/compose/d7/*.yml text eol=lf
